////People Depot Schema Entity Relationship Diagram
// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

TablePartial AbstractBaseModel {
  id uuid [pk, unique, not null]
  created_at DateTimeField [not null, default: `now()`]
  updated_at DateTimeField [not null, default: `now()`]
}

Table Accomplishment {
  ~AbstractBaseModel
  project uuid [ref: > Project.id]
  title varchar
  description varchar
  url URLField
  accomplished_on DateField
}

Table Affiliate {
  //created
  //formerly sponsor_partner
  ~AbstractBaseModel
  name varchar
  logo URLField
  is_active boolean
  url URLField
  is_org_sponsor boolean
  is_org_partner boolean
  //considering adding org_id
}

Table CancelledEvent {
  ~AbstractBaseModel
  event uuid [ref: > Event.id]
  start_time DateTimeField
  cancelled_on DateField
  reason varchar
  cancelled_by uuid [ref: > User.id]
}

Table CheckIn {
  ~AbstractBaseModel
  event_occurrence uuid [ref: > EventOccurrence.id]
  user uuid [ref: > User.id]
  checked_in DateTimeField
}

Table CheckType [note: 'Data tab: https://docs.google.com/spreadsheets/d/1x_zZ8JLS2hO-zG0jUocOJmX16jh-DF5dccrd_OEGNZ0/edit?gid=1784987068#gid=1784987068'] {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table Event {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
  event_type uuid [ref: > EventType.id]
  start_time DateTimeField
  duration_in_min int
  rrule RecurrenceField [note: 'recurrence rule, used by django-recurrence']
  project uuid [ref: > Project.id]
  video_conference_url URLField
  location uuid [ref: > Location.id]
  additional_info varchar
  must_attend JSON
  should_attend JSON
  could_attend JSON
  last_generated DateTimeField
  previous_version uuid [ref: > Event.id]
}

Table EventOccurrence {
  ~AbstractBaseModel
  event uuid [ref: > Event.id]
  start_time DateTimeField
  changes uuid [ref: > EventOccurrenceChange.id]
}

Table EventOccurrenceChange {
  ~AbstractBaseModel
  event uuid [ref: > Event.id]
  start_time DateTimeField
  name_change varchar
  description_change varchar
  event_type_change uuid [ref: > EventType.id]
  start_time_change DateTimeField
  duration_in_min_change int
  video_conference_url_change URLField
  location_change uuid [ref: > Location.id]
  additional_info_change varchar
  must_attend_change JSON
  should_attend_change JSON
  could_attend_change JSON
}

Table EventType {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table Faq {
  //created
  ~AbstractBaseModel
  question varchar
  answer varchar
  project uuid [ref: > Project.id]
  permission_type uuid [ref: > PermissionType.id]
  title varchar
}

Table FaqViewed {
  //created
  ~AbstractBaseModel
  faq uuid [ref: > Faq.id, not null]
  read int
}

Table GithubTeamRepoPermissionType {
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table GithubTeamRepoPermissionXref {
  ~AbstractBaseModel
  github_team uuid [ref: > ProjectGithubTeamXref.id]
  github_repo varchar
  github_team_repo_permission_type uuid [ref: > GithubTeamRepoPermissionType.id]
}

Table Language {
  ~AbstractBaseModel
  name varchar
  description varchar
  logo URLField
}

Table LeadershipType {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table Location {
  //created
  ~AbstractBaseModel
  name varchar
  address_line_1 varchar
  address_line_2 varchar
  city varchar
  state varchar
  zip varchar
  phone varchar
}

Table ModernJobTitle {
  ~AbstractBaseModel
  soc_detailed uuid [ref: > SOCDetailed.id]
  title varchar
}

Table Organization {
  ~AbstractBaseModel
  name varchar
  time_zone varchar
}

Table Permission {
  //created
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  project uuid [ref: > Project.id]
  permission_type uuid [ref: > PermissionType.id]
  practice_area uuid [ref: > PracticeArea.id]
  granted DateTimeField
  ended DateTimeField
  created_by uuid [ref: > User.id]
  updated_by uuid [ref: > User.id]
}

Table PermissionHistory {
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  project uuid [ref: > Project.id]
  permission_type uuid [ref: > PermissionType.id]
  practice_area uuid [ref: > PracticeArea.id]
  granted DateTimeField
  ended DateTimeField
  created_by int
  updated_by int
}

Table PermissionType {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
  rank int
}

Table PracticeArea {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
  image URLField
}

Table ProgramArea {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
  image URLField
  program_area_status uuid [ref: > ProgramAreaStatusType.id]
}

Table ProgramAreaStatusType {
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table Project {
  //created
  ~AbstractBaseModel
  name String
  description String
  completed_on date
  github_org uuid [ref: - ProjectUrl.id, note: 'The unique id assigned to GitHub orgs. A foreign key to a row in ProjectUrl that corresponds to the org repo link']
  github_primary_repo_url uuid [ref: - ProjectUrl.id, note: 'A project might have many repos, this is for the primary starting place for new users. A foreign key to a row in ProjectUrl that corresponds to the primary repo']
  github_primary_repo_id int
  project_status uuid [ref: > ProjectStatusType.id]
  hide Boolean
  google_drive_main uuid [ref: > ProjectUrl.id, note: 'The unique id of the main google drive, used for adding people with automation. A foreign key to a row in ProjectUrl that corresponds to the google drive.']
  google_drive_pii uuid [ref: > ProjectUrl.id, note: 'The unique id of the google drive for PII. People are added manually and removed with automation. A foreign key to a row in ProjectUrl that corresponds to the google drive.']
  slack uuid [ref: - ProjectUrl.id, note: 'The unique id assigned to slack channel. A foreign key to a row in ProjectUrl that corresponds to the org repo link']
  project_leads uuid[] (user_id)
  leadership_type uuid [ref: > LeadershipType.id]
  image_logo URLField
  image_hero URLField
  image_icon URLField
  is_cop bool [note: 'TRUE if the project is a community of practice, otherwise FALSE']
}

Table ProjectAffiliateXref {
  //created
  ~AbstractBaseModel
  affiliate uuid [ref: > Affiliate.id]
  project uuid [ref: > Project.id]
  ended DateField
  is_sponsor boolean
  is_partner boolean
}

Table ProjectGithubTeamXref {
  ~AbstractBaseModel
  project uuid [ref: > Project.id]
  github_team_repo_permission_type uuid [ref: > GithubTeamRepoPermissionType.id]
}

Table ProjectProgramAreaXref {
  //created
  ~AbstractBaseModel
  project uuid [ref: > Project.id]
  program_area uuid [ref: > ProgramArea.id]
}

Table ProjectSDGTargetIndicatorXref {
  //created
  ~AbstractBaseModel
  sdg_target_indicator uuid [ref: > SDGTargetIndicator.id]
  project uuid [ref: > Project.id]
  ended_on DateField
}

Table ProjectStackElementXref {
  ~AbstractBaseModel
  project uuid [ref: > Project.id]
  stack_element uuid [ref: > StackElement.id]
  removed_on DateField
}

Table ProjectStatusType [note: 'currently named projectstatus in code'] {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}
/*
//Potentially removed table
Table ProjectProgramAreaStatusHistory [note: 'currently named project_program_area_status in open issue'] {
  ~AbstractBaseModel
  project int [ref: > Project.id]
  status int [ref: > ProjectProgramAreaStatusType.id]
}
*/

Table ProjectUrl {
  ~AbstractBaseModel
  project uuid [ref: > Project.id]
  url_type uuid [ref: > UrlType.id]
  name CharField
  external_id CharField [note: 'resource id provided by GitHub or google']
  url URLField
  url_status_type uuid [ref: > UrlStatusType.id]
}

Table Referrer {
  //created
  ~AbstractBaseModel
  name varchar
  url URLField
  referrer_type uuid [ref: > ReferrerType.id]
  contact_name varchar
  contact_email EmailField
}

Table ReferrerType {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table SDG {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
  image URLField
}

Table SDGTargetIndicator {
  ~AbstractBaseModel
  sdg uuid [ref: > SDG.id]
  code varchar
  description_number varchar
  description_text varchar
}

Table Skill {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table SOCBroad {
  ~AbstractBaseModel
  soc_minor uuid [ref: > SOCMinor.id]
  occ_code varchar
  title varchar
}

Table SOCDetailed {
  ~AbstractBaseModel
  soc_broad uuid [ref: > SOCBroad.id]
  occ_code varchar
  title varchar
  description varchar
}


Table SOCMajor {
  //created
  ~AbstractBaseModel
  occ_code varchar
  title varchar
}

Table SOCMinor {
  ~AbstractBaseModel
  soc_major uuid [ref: > SOCMajor.id]
  occ_code varchar
  title varchar
}

Table StackElement {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
  url URLField
  logo URLField
  active boolean
  stack_element_type uuid [ref: > StackElementType.id]
}

Table StackElementType {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table UrlStatusType {
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table UrlType {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table User {
  //created
  ~AbstractBaseModel
  first_name varchar
  last_name varchar
  email EmailField [note:'The email given during intake']
  email_gmail EmailField
  email_preferred EmailField
  is_active bool [default: True, note:'Required by django. A boolean field that indicates whether the user\'s account is active.']
  user_status_type uuid [ref: > UserStatusType.id]
  practice_area_primary uuid [ref: > PracticeArea.id]
  practice_area_secondary uuid[] [ref: > UserPracticeAreaSecondaryXref.id]
  job_title_current varchar
  practice_area_target uuid [ref: > UserPracticeAreaTargetIntakeXref.id]
  job_title_target varchar
  intake_present_job_title	varchar
  intake_present_skills	varchar
  intake_target_job_titles	varchar
  intake_target_skills uuid [ref: > UserIntakeTargetSkillXref.id]
  current_job_title	varchar
  current_skills uuid[]
  current_target_job_titles	varchar
  current_target_skills	varchar
  linkedin_account URLField
  referred_by uuid [ref: > Referrer.id]
  github_handle varchar
  phone varchar
  texting_ok boolean
  slack_id varchar(11)
  time_zone varchar [note: 'full time zone name']
}

Table UserAvailability {
  ~AbstractBaseModel
  user uuid [ref: > User.id, not null]
  day_of_week day (enum)
  start TimeField
  duration_minutes int
}

Table UserCheck {
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  check_type uuid [ref: > CheckType.id]
  result boolean
  reminder_start DateTimeField
  completed_at DateTimeField
  project uuid [ref: > Project.id]
}

Table UserEmploymentHistory {
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  modern_job_title uuid [ref: > ModernJobTitle.id]
}

Table UserIntakeTargetSkillXref {
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  skill uuid [ref: > Skill.id]
}

Table UserPracticeAreaSecondaryXref {
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  practice_area uuid [ref: > PracticeArea.id]
}

Table UserPracticeAreaTargetIntakeXref {
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  practice_area uuid [ref: > PracticeArea.id]
}

Table UserStatusType {
  //created
  ~AbstractBaseModel
  name varchar
  description varchar
}

Table Win {
  ~AbstractBaseModel
  user uuid [ref: > User.id]
  practice_areas uuid[] [ref: <> PracticeArea.id]
  projects uuid[] [ref: <> Project.id]
  description varchar
  win_type uuid [ref: > WinType.id]
  can_use_photo boolean
}

Table WinType {
  ~AbstractBaseModel
  name varchar
  display_text varchar
}
